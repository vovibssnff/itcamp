{
  "uid": "ktc-ai-metrics",
  "title": "KTC AI Service",
  "tags": ["ktc", "ai"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "editable": true,
  "time": { "from": "now-30m", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Data source",
        "current": { "text": "Prometheus", "value": "Prometheus" }
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Requests per second",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] }
        }
      },
      "targets": [
        { "expr": "sum(rate(ai_requests_total{job=\"ktk-ai\"}[$__rate_interval]))", "legendFormat": "RPS" }
      ]
    },
    {
      "type": "stat",
      "title": "Fallback rate",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 0.1 }, { "color": "red", "value": 0.3 } ] }
        }
      },
      "targets": [
        { "expr": "sum(rate(ai_fallback_total{job=\"ktk-ai\"}[$__rate_interval])) / sum(rate(ai_requests_total{job=\"ktk-ai\"}[$__rate_interval]))", "legendFormat": "fallback rate" }
      ]
    },
    {
      "type": "stat",
      "title": "Validation rejections",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] }
        }
      },
      "targets": [
        { "expr": "sum(rate(ai_validation_reject_total{job=\"ktk-ai\"}[$__rate_interval]))", "legendFormat": "rejects/s" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Requests (total vs fallback)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [
        { "expr": "sum(rate(ai_requests_total{job=\"ktk-ai\"}[$__rate_interval]))", "legendFormat": "requests" },
        { "expr": "sum(rate(ai_fallback_total{job=\"ktk-ai\"}[$__rate_interval]))", "legendFormat": "fallbacks" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Request duration (p50/p95)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(ai_request_duration_seconds_bucket{job=\"ktk-ai\"}[$__rate_interval])))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(ai_request_duration_seconds_bucket{job=\"ktk-ai\"}[$__rate_interval])))", "legendFormat": "p95" }
      ]
    }
  ],
  "nav": [ { "type": "timepicker" } ]
}
