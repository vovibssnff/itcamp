# ─────────────────────────────────────────────────────────────
# Локальное окружение слоя ktc-sim (Simulation Engine).
# Скопируйте в compose/sim/.env и при необходимости скорректируйте.
# НЕ коммитьте .env (секреты).
# ─────────────────────────────────────────────────────────────

COMPOSE_PROJECT_NAME=ktk-sim

# Сеть data-plane (создаётся слоем ktc-data: compose/data)
DATA_NETWORK=ktc-data

# --- Порты наружу (host) ---
# Не конфликтуют с другими слоями: 8080 (ai), 8081 (assessment), 8082-8088 (app).
SIM_MANAGER_HOST_PORT=8091
SIM_WORKER_REST_HOST_PORT=8092
SIM_WORKER_GRPC_HOST_PORT=50062

# --- Математическая модель sim-worker ---
KTC_SIM_TEMPLATE_FILE=template_atm_demo.json
KTC_SIM_FAULTS_FILE=faults_catalog.json
KTC_SIM_TICK_HZ=1.0
KTC_SIM_DEFAULT_SEED=42
