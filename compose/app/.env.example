# ─────────────────────────────────────────────────────────────
# Локальное окружение dev-сервисов (ktc).
# Скопируйте в dev/.env и при необходимости скорректируйте.
# НЕ коммитьте .env (секреты).
# ─────────────────────────────────────────────────────────────

COMPOSE_PROJECT_NAME=ktc-dev

# --- Data-plane (будут подняты из инфраструктурного compose infra/local) ---
# Хосты внутри сети ktc-data (см. infra/local) — менять не нужно.
DATA_NETWORK=ktc-data

# --- Picodata (PG-wire) ---
DB_HOST=picodata
DB_PORT=4327
DB_USER=admin
DB_PASSWORD=T0psecret
DB_NAME=postgres
# Общий DSN для всех сервисов и мигратора
DB_DSN=postgres://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?sslmode=disable

# --- MinIO (S3) ---
S3_ENDPOINT=minio:9000
S3_ACCESS_KEY=ktcminio
S3_SECRET_KEY=ktcminio_secret

# --- NATS ---
NATS_URL=nats://nats:4222

# --- Redis (Radix stand-in, сервис radix в infra/local) ---
REDIS_ADDR=radix:7379

# --- JWT (auth) ---
# Минимум 32 байта для HS256.
JWT_SIGNING_KEY=dev-only-signing-key-please-change-1234567890
# Ровно 32 байта (AES-256).
TOTP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# --- Порты наружу (host) ---
HTTP_ASSESSMENT=8081
HTTP_AUTH=8082
HTTP_CONSTRUCTOR=8083
HTTP_SCENARIO=8084
HTTP_ORCHESTRATOR=8085
HTTP_SNAPSHOT=8086
HTTP_REPORT=8087
HTTP_GW=8088
HTTP_FRONTEND=8090
