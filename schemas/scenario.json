{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ktk.local/schemas/scenario.json",
  "title": "Scenario",
  "description": "Учебный/экзаменационный сценарий (plan §12.1). Привязан к шаблону установки; неисправности вносятся только автоматически по триггерам (FR-ROLE-04).",
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "template_id": { "type": "string" },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "type": { "type": "string", "enum": ["training", "exam"] },
    "start_preset_id": { "type": ["string", "null"] },
    "faults": {
      "type": "array",
      "items": { "$ref": "#/$defs/fault" }
    },
    "reference_actions": {
      "type": "array",
      "items": { "$ref": "#/$defs/reference_action" }
    },
    "criteria": { "$ref": "#/$defs/criteria" }
  },
  "required": ["id", "template_id", "name", "type", "faults"],
  "additionalProperties": false,
  "$defs": {
    "fault": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fault_id": {
          "type": "string",
          "description": "Ссылка на faults_catalog.fault_id."
        },
        "component_instance_id": { "type": "string" },
        "params": {
          "type": "object",
          "properties": {
            "severity_pct": { "type": "number", "minimum": 0, "maximum": 100 },
            "ramp_seconds": { "type": "number", "minimum": 0 }
          },
          "additionalProperties": true
        },
        "trigger": { "$ref": "#/$defs/trigger" },
        "hidden": { "type": "boolean", "default": false }
      },
      "required": ["id", "fault_id", "component_instance_id", "trigger"],
      "additionalProperties": false
    },
    "trigger": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": { "const": "time" },
            "at_model_time": { "type": "number", "minimum": 0 }
          },
          "required": ["type", "at_model_time"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": { "const": "condition" },
            "condition": {
              "type": "object",
              "properties": {
                "tag": { "type": "string" },
                "op": { "type": "string", "enum": [">", ">=", "<", "<=", "==", "!="] },
                "value": { "type": "number" },
                "for_seconds": { "type": "number", "minimum": 0 }
              },
              "required": ["tag", "op", "value"],
              "additionalProperties": false
            }
          },
          "required": ["type", "condition"],
          "additionalProperties": false
        }
      ]
    },
    "reference_action": {
      "type": "object",
      "properties": {
        "step": { "type": "integer", "minimum": 1 },
        "description": { "type": "string" },
        "expected": {
          "type": "object",
          "properties": {
            "target": { "type": "string" },
            "action": { "type": "string" },
            "value": {}
          },
          "required": ["target", "action"],
          "additionalProperties": true
        },
        "deadline_seconds": { "type": "number", "minimum": 0 },
        "mandatory": { "type": "boolean", "default": true }
      },
      "required": ["step", "expected"],
      "additionalProperties": false
    },
    "criteria": {
      "type": "object",
      "properties": {
        "max_score": { "type": "number" },
        "penalty_late": { "type": "number" },
        "penalty_miss": { "type": "number" },
        "penalty_forbidden": { "type": "number" },
        "critical_actions": { "type": "array", "items": { "type": "string" } },
        "pass_threshold": { "type": "number" }
      },
      "additionalProperties": true
    }
  }
}
