# Real local stack: relative /api (and WS) via Vite proxy → gw.
# Leave API/WS bases empty so the browser stays same-origin on :5173.
VITE_API_BASE_URL=
VITE_WS_BASE_URL=
VITE_DEV_PROXY_TARGET=http://localhost:8088

# Set to "true" to run against MSW mocks + mock WebSocket (used by Playwright E2E).
VITE_MOCK_API=false
