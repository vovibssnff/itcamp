# ── Слой ktc-mon ────────────────────────────────────────────

# Порт Prometheus наружу (host)
PROMETHEUS_HOST_PORT=9090
# Порт Grafana наружу (host)
GRAFANA_HOST_PORT=3000
# Порт cAdvisor наружу (host) — 8080 занят ai-service
CADVISOR_HOST_PORT=18080

# Версии образов
PROMETHEUS_VERSION=v2.54.1
GRAFANA_VERSION=11.3.1
CADVISOR_VERSION=v0.49.1

# Параметры хранения
PROM_RETENTION=30d

# Доступ в Grafana (http://localhost:3000, admin/admin по умолчанию)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
