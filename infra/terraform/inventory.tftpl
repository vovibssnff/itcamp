# AUTO-GENERATED by terraform apply — do not edit by hand.
# Regenerate: cd infra/terraform && terraform apply -var-file=env/prod.tfvars

[all:vars]
ansible_user=ubuntu
ansible_ssh_private_key_file=~/.ssh/ktc_ed25519
ktc_domain=${domain}
ktc_ingress_fip=${ingress_fip}
ktc_cluster_name=${cluster_name}

%{ for role in ["app", "sim", "ai", "db"] ~}
[${role}]
%{ for name, n in nodes ~}
%{ if n.role == role ~}
${name} ansible_host=${n.ip} ktc_role=${n.role}
%{ endif ~}
%{ endfor ~}

%{ endfor ~}
[static:children]
app
sim
ai
db
