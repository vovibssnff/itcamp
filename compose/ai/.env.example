# ─────────────────────────────────────────────────────────────
# Локальное окружение слоя ktk-ai (ИИ-сервис + Ollama).
# Скопируйте в compose/ai/.env и при необходимости скорректируйте.
# НЕ коммитьте .env (секреты).
# ─────────────────────────────────────────────────────────────

COMPOSE_PROJECT_NAME=ktk-ai

# Сеть data-plane (создаётся слоем ktc-data: compose/data)
DATA_NETWORK=ktc-data

# --- Images ---
OLLAMA_IMAGE=ollama/ollama:latest

# --- Модель LLM ---
KTK_LLM_PROVIDER=ollama
KTK_OLLAMA_URL=http://ollama:11434
KTK_LLM_MODEL=qwen2.5:14b-instruct

# Чат-бот в экзамене работает как открытый справочник (нет телеметрии).
# Поставьте false для закрытой аттестации.
KTK_CHAT_IN_EXAM=true

# --- Порты наружу (host) ---
OLLAMA_HOST_PORT=11434
AI_HTTP_HOST_PORT=8080
AI_GRPC_HOST_PORT=50051
