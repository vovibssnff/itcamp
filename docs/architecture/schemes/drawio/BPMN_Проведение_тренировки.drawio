        <mxCell id="tApplyFault" value="Применить&#xa;неисправность к модели" style="shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="laneSys">
          <mxGeometry x="830" y="70" width="170" height="70" as="geometry" />
