# Copy to .env and adjust. Do not commit .env.

COMPOSE_PROJECT_NAME=ktc-local

# --- Images (pinned) ---
PICODATA_IMAGE=docker.binary.picodata.io/picodata:25.5.9
# Community Edition has no Radix plugin; redis stands in on port 7379 (Radix-compatible URL).
RADIX_IMAGE=redis:7.4-alpine
MINIO_IMAGE=minio/minio:RELEASE.2025-04-22T22-12-26Z
MINIO_MC_IMAGE=minio/mc:RELEASE.2025-04-16T18-13-26Z
NATS_IMAGE=nats:2.11-alpine
NATS_BOX_IMAGE=natsio/nats-box:0.16.0
PSQL_IMAGE=postgres:16-alpine

# --- Picodata (PG-wire inside container listens on 4327) ---
PICODATA_ADMIN_PASSWORD=T0psecret
PICODATA_CLUSTER_NAME=ktc
# Host port mapped to container 4327
PICODATA_HOST_PORT=5432

# App DSN (from other compose services on ktc-data):
# PICODATA_DSN=postgres://admin:${PICODATA_ADMIN_PASSWORD}@picodata:4327/postgres

# --- Radix / Redis cache (port 7379 to match future Radix standalone) ---
RADIX_HOST_PORT=7379
# RADIX_URL=redis://radix:7379/0

# --- MinIO ---
MINIO_ROOT_USER=ktcminio
MINIO_ROOT_PASSWORD=ktcminio_secret
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
# S3_ENDPOINT=http://minio:9000

# --- NATS ---
NATS_CLIENT_HOST_PORT=4222
NATS_MONITOR_HOST_PORT=8222
# NATS_URL=nats://nats:4222
