### ============================================================
### auth — Аутентификация и пользователи (сервис auth)
### Базовый URL. Скорректируйте порт под конфигурацию вашего сервиса.
### ============================================================

@host = http://localhost
@port = 8082
@base = {{host}}:{{port}}
@login = operator
@password = operator123
@userId = user_123

### Проверка живости сервиса
GET {{base}}/healthz

### Вход в систему (Basic + MFA)
POST {{base}}/login
Content-Type: application/json

{
  "login": "{{login}}",
  "password": "{{password}}",
  "mfa_code": "123456"
}

> {%
    client.global.set("access_token", response.body.access_token);
    client.global.set("refresh_token", response.body.refresh_token);
%}

### Обновить access-токен
POST {{base}}/refresh
Content-Type: application/json

{
  "refresh_token": "{{refresh_token}}"
}

### Выход из системы
POST {{base}}/logout
Content-Type: application/json

{
  "refresh_token": "{{refresh_token}}"
}

### Текущий пользователь
GET {{base}}/me
Authorization: Bearer {{access_token}}

### Интроспекция токена
POST {{base}}/introspect
Content-Type: application/json

{
  "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJleHAiOjE3ODYyODk5NDAsImlhdCI6MTc4NjI4OTA0MCwiaXNzIjoia3RjLWF1dGgiLCJqdGkiOiI3ZmE1OTA3ZGQ1NWU0NjgzMGY3Yjk2NmI3ZGFiM2RhZDI2NTRlM2Q3NzQ1NjVlZGU0OTZiZDAzZGFmYzM2MjdiIiwibG9naW4iOiJvcGVyYXRvciIsInJvbGVzIjpbIm9wZXJhdG9yIl0sInVpZCI6ImVmODA5YmM1LWNmZjgtNDJkOC1iYTljLTgzZGE2Y2ViN2QyZiJ9.ln9RhR4MQK7DQymfeprA1hjIPqg2Qr17YKXCKWr-sRo"
}

### Список пользователей
GET {{base}}/users?limit=50&offset=0
Authorization: Bearer {{access_token}}

### Получить пользователя по ID
GET {{base}}/users/{{userId}}
Authorization: Bearer {{access_token}}

### Настроить MFA для пользователя (получить secret/QR)
POST {{base}}/users/{{userId}}/mfa/setup

### Включить MFA по коду
POST {{base}}/users/{{userId}}/mfa/enable
Content-Type: application/json

{
  "code": "123456"
}

### Статус MFA пользователя
GET {{base}}/users/{{userId}}/mfa
