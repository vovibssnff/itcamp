{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ktc.itcamp/schemas/scenario.json",
  "title": "Scenario",
  "description": "Сценарий тренировки/экзамена (SRD §3.4, §3.5)",
  "type": "object",
  "required": ["id", "template_id", "name", "type", "faults", "reference_actions", "criteria"],
  "properties": {
    "id":              { "type": "string" },
    "template_id":     { "type": "string" },
    "name":            { "type": "string" },
    "description":     { "type": "string" },
    "type":            { "type": "string", "enum": ["training", "exam"] },
    "start_preset_id": { "type": "string" },
    "author_id":       { "type": "string" },
    "faults": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "fault_id", "component_instance_id", "params", "trigger"],
        "properties": {
          "id":                    { "type": "string" },
          "fault_id":              { "type": "string" },
          "component_instance_id": { "type": "string" },
          "params": {
            "type": "object",
            "properties": {
              "severity_pct":  { "type": "number", "minimum": 0, "maximum": 100 },
              "ramp_seconds":  { "type": "number", "minimum": 0 }
            }
          },
          "trigger": {
            "type": "object",
            "properties": {
              "type":  { "type": "string", "enum": ["time", "condition"] },
              "at_model_time": { "type": "number" },
              "condition": {
                "type": "object",
                "properties": {
                  "tag":         { "type": "string" },
                  "op":          { "type": "string", "enum": [">=", "<=", ">", "<", "=="] },
                  "value":       { "type": "number" },
                  "for_seconds": { "type": "number" }
                }
              }
            }
          },
          "hidden": { "type": "boolean", "default": false }
        }
      }
    },
    "reference_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "step":             { "type": "integer" },
          "description":      { "type": "string" },
          "expected": {
            "type": "object",
            "properties": {
              "target": { "type": "string" },
              "action": { "type": "string" },
              "value":  {}
            }
          },
          "deadline_seconds": { "type": "integer" },
          "mandatory":        { "type": "boolean" }
        }
      }
    },
    "criteria": {
      "type": "object",
      "properties": {
        "max_score":          { "type": "integer", "default": 100 },
        "penalty_late":       { "type": "integer" },
        "penalty_miss":       { "type": "integer" },
        "penalty_forbidden":  { "type": "integer" },
        "critical_actions":   { "type": "array", "items": { "type": "string" } },
        "pass_threshold":     { "type": "integer" }
      }
    }
  }
}
